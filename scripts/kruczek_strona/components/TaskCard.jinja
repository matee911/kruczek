{#def karta, pokaz_sprawe=True, blad="", wartosc="" #}
{% set formularz_daty = karta.akcja == "doreczenie" and not pokaz_sprawe %}
<article class="k-task" id="{{ karta.dom_id }}">
  <div class="k-task__top">
    {% if karta.status %}<StatusChip status={{ karta.status }} />{% endif %}
    <span class="k-task__when">{{ karta.kiedy }}</span>
  </div>
  <h3 class="k-task__title">{{ karta.zadanie.opis }}</h3>
  {% if karta.dlaczego %}<p class="k-task__why">{{ karta.dlaczego }}</p>{% endif %}
  {% for u in karta.uwagi %}<p class="k-task__why"><Icon name="calendar" /> {{ u }}</p>{% endfor %}
  <CaseRef url={{ karta.url }} klucz={{ karta.klucz }} watek={{ karta.zadanie.watek or "" }} zadanie_id={{ karta.zadanie.id }} pokaz_sprawe={{ pokaz_sprawe }} />
  {% if blad and not formularz_daty %}<p class="k-task__why" role="alert"><Icon name="triangle-alert" />{{ blad }}</p>{% endif %}
  {% if formularz_daty %}
    <DeliveryForm karta={{ karta }} blad={{ blad }} wartosc={{ wartosc }} />
  {% elif karta.akcja == "doreczenie" %}
    <div class="k-task__actions"><Button href={{ karta.url ~ "#" ~ karta.dom_id }}>Wpisz doręczenie</Button></div>
  {% elif karta.akcja == "polecenie" %}
    <CommandCopy value={{ karta.polecenie }} id={{ karta.dom_id ~ "-polecenie" }} hint="Wklej w rozmowie z Claude:" variant="" />
    <div class="k-task__actions"><DoneForm karta={{ karta }} variant="ghost" /></div>
  {% elif karta.akcja == "zrobione" %}
    <div class="k-task__actions">
      <DoneForm karta={{ karta }} />
      {% if pokaz_sprawe %}<Button variant="ghost" href={{ karta.url }}>Pokaż sprawę</Button>{% endif %}
    </div>
  {% endif %}
</article>
