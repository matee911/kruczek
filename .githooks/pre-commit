#!/usr/bin/env bash
# Hook pre-commit kruczka — odpala wszystkie testy przed zapisaniem commita.
#
# Celowo BEZ narzędzia `pre-commit` z PyPI: kruczek nie ma zależności runtime i nie
# zamierza ich mieć, a jeden hak nie jest wart wprowadzania menedżera haków.
#
# Włączenie (raz, po sklonowaniu repo):
#     git config core.hooksPath .githooks
#
# Pominięcie w wyjątkowej sytuacji:
#     git commit --no-verify
set -euo pipefail

REPO="$(git rev-parse --show-toplevel)"

# Repo jest publiczne. Dokument z „nie commitować” w treści to notatka robocza z danymi spraw —
# zatrzymujemy commit, zanim pójdą testy. Sprawdzamy cały indeks, czyli dokładnie to, co trafi do commita.
# Hook i jego test same zawierają znacznik, więc są wyłączone.
if ZAKAZANE=$(git grep --cached -l -i -E 'nie commitowa|do not commit' -- . \
    ':!.githooks/pre-commit' ':!tests/test_hook_pre_commit.py'); then
  echo "✗ Pliki oznaczone „nie commitować” — commit wstrzymany:"
  echo "${ZAKAZANE}" | sed 's/^/    /'
  echo "Wyjmij je z indeksu: git restore --staged <plik> (miejsce na notatki robocze: .superpowers/)"
  exit 1
fi

# Kod wymaga Pythona >= 3.11, a systemowy python3 bywa starszy (macOS: 3.9) — przez uv dostajemy 3.11.
# Bez uv zostaje python3 z PATH (np. Linux z nowszym Pythonem). `--no-project` wyłącza synchronizację .venv
# z grupą dev przy każdym commicie, a `--isolated` nie pozwala uv wziąć istniejącego .venv jako interpretera —
# inaczej run_tests widziałby pakiety spoza stdlib i sprawdzenie „tylko stdlib” przestałoby działać.
if command -v uv >/dev/null 2>&1; then
  TESTY=(uv run --no-project --isolated --python 3.11 python "${REPO}/scripts/run_tests.py")
else
  TESTY=(python3 "${REPO}/scripts/run_tests.py")
fi

echo "pre-commit: testy (unittest + doctesty)…"
if ! "${TESTY[@]}" >/tmp/kruczek-pre-commit.log 2>&1; then
  echo
  echo "✗ Testy nie przechodzą — commit wstrzymany."
  echo
  tail -30 /tmp/kruczek-pre-commit.log
  echo
  echo "Pełny log: /tmp/kruczek-pre-commit.log"
  echo "Świadome pominięcie: git commit --no-verify"
  exit 1
fi
echo "✓ testy OK"
